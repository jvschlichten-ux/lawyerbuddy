{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@lawyerbuddy/shared": ["packages/shared/src"],
      "@lawyerbuddy/i18n": ["packages/i18n/src"],
      "@lawyerbuddy/api": ["packages/api/src"],
      "@lawyerbuddy/security": ["packages/security/src"]
    }
  }
}
